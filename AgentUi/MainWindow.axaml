<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="AgentUi.MainWindow"
        Title="LocalAgent"
        Width="1280" Height="800">

    <Grid ColumnDefinitions="320,*,360">
        <!-- Левая панель: Thinking / Reasoning / Tool calls -->
        <Grid Grid.Column="0" RowDefinitions="*,*,*" Margin="10,10,0,10">
            <Grid Grid.Row="0" RowDefinitions="Auto,*" Margin="0,0,10,10">
                <TextBlock Text="🤔 Thinking" FontWeight="Bold" Margin="0,0,0,5"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="ThinkingBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,0,10,10">
                <TextBlock Text="🧠 Reasoning" FontWeight="Bold" Margin="0,0,0,5"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="ReasoningBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,0,10,0">
                <TextBlock Text="🛠 Tool calls" FontWeight="Bold" Margin="0,0,0,5"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="ToolCallBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Левая часть: диалог -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="10">

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="LogBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"/>
            </ScrollViewer>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         PlaceholderText="Сообщение…  (Enter — отправить, Shift+Enter — перенос строки)"
                         MinHeight="70" MaxHeight="180"/>
                <Button Grid.Column="1"
                        x:Name="SendButton"
                        Content="➤ Отправить"
                        Width="120"
                        Margin="10,0,0,0"
                        Click="OnSendClick"/>
            </Grid>
        </Grid>

        <!-- Правая часть: настройки -->
        <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <TextBlock Text="⚙ Настройки" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                    <TabControl>

                        <!-- Вкладка 1: Системные настройки -->
                        <TabItem Header="Системные настройки">
                            <StackPanel Margin="5">

                                <TextBlock Text="Профиль:" Margin="0,5,0,5"/>
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <ComboBox Grid.Column="0" x:Name="ProfileBox" SelectionChanged="OnProfileChanged"/>
                                    <Button Grid.Column="1" Content="+" Width="34" Margin="5,0,0,0" Click="OnAddProfile" ToolTip.Tip="Добавить профиль"/>
                                    <Button Grid.Column="2" Content="✎" Width="34" Margin="5,0,0,0" Click="OnRenameProfile" ToolTip.Tip="Переименовать профиль"/>
                                    <Button Grid.Column="3" Content="X" Width="34" Margin="5,0,0,0" Click="OnDeleteProfile" ToolTip.Tip="Удалить профиль"/>
                                </Grid>

                                <TextBlock Text="Пользователь системы:" Margin="0,10,0,5"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ComboBox Grid.Column="0" x:Name="UserBox" SelectionChanged="OnUserChanged"/>
                                    <Button Grid.Column="1" Content="✔" Width="34" Margin="5,0,0,0" Click="OnTestUser" ToolTip.Tip="Проверить (whoami)"/>
                                </Grid>

                                <TextBlock Text="Папки агента:" Margin="0,10,0,5"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" x:Name="GrantPathBox" PlaceholderText="/путь/к/папке"/>
                                    <Button Grid.Column="1" Content="+" Width="34" Margin="5,0,0,0" Click="OnGrantFolder" ToolTip.Tip="Выдать доступ"/>
                                </Grid>
                                <ListBox x:Name="AllowedFoldersBox" Margin="0,5,0,5" MaxHeight="120"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Button Content="... Выбрать папку" Click="OnPickGrantFolder"/>
                                    <Button Content="- Отозвать" Margin="5,0,0,0" Click="OnRevokeFolder"/>
                                </StackPanel>

                                <TextBox x:Name="UrlBox" PlaceholderText="http://localhost:11434" Margin="0,5,0,5"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                                    <TextBox Grid.Column="0" x:Name="ModelBox" PlaceholderText="модель"/>
                                    <TextBox Grid.Column="1" x:Name="KeyBox" PlaceholderText="API-ключ" Width="130" Margin="5,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Папка дневника:" Margin="0,10,0,5"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" x:Name="DiaryPathBox"/>
                                    <Button Grid.Column="1" Content="..." Width="34" Margin="5,0,0,0" Click="OnPickDiaryPath"/>
                                </Grid>

                                <TextBlock Text="Папка памяти:" Margin="0,10,0,5"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" x:Name="MemoryPathBox"/>
                                    <Button Grid.Column="1" Content="..." Width="34" Margin="5,0,0,0" Click="OnPickMemoryPath"/>
                                </Grid>

                                <TextBlock Text="Контекст (сообщений):" Margin="0,10,0,5"/>
                                <NumericUpDown x:Name="ContextLimitBox" ValueChanged="OnContextLimitChanged"/>

                                <TextBlock Text="Авто-новый дневник (токенов):" Margin="0,10,0,5"/>
                                <NumericUpDown x:Name="AutoNewDiaryTokensBox" ValueChanged="OnAutoNewDiaryTokensChanged"/>

                                <Button x:Name="NewDiaryButton" Content="🗒 Новый дневник" Margin="0,10,0,5" Click="OnNewDiary"/>
                                <Button x:Name="MemoryButton" Content="🧠 Создать память" Click="OnMakeMemory"/>

                                <TextBlock x:Name="TokenCounterText" Margin="0,10,0,0"/>
                            </StackPanel>
                        </TabItem>

                        <!-- Вкладка 2: Настройки LLM -->
                        <TabItem Header="Настройки LLM">
                            <StackPanel Margin="5">

                                <TextBlock Text="Профиль LLM:" Margin="0,5,0,5"/>
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <ComboBox Grid.Column="0" x:Name="LlmProfileBox" SelectionChanged="OnLlmProfileChanged"/>
                                    <Button Grid.Column="1" Content="+" Width="34" Margin="5,0,0,0" Click="OnAddLlmProfile" ToolTip.Tip="Добавить профиль"/>
                                    <Button Grid.Column="2" Content="✎" Width="34" Margin="5,0,0,0" Click="OnRenameLlmProfile" ToolTip.Tip="Переименовать профиль"/>
                                    <Button Grid.Column="3" Content="X" Width="34" Margin="5,0,0,0" Click="OnDeleteLlmProfile" ToolTip.Tip="Удалить профиль"/>
                                </Grid>

                                <TextBlock Text="Температура (0–2):" Margin="0,10,0,5"/>
                                <NumericUpDown x:Name="TemperatureBox" Minimum="0" Maximum="2" Increment="0.1" FormatString="0.0"/>

                                <TextBlock Text="Top P (0–1):" Margin="0,10,0,5"/>
                                <NumericUpDown x:Name="TopPBox" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00"/>

                                <TextBlock Text="Штраф повторов (1–2):" Margin="0,10,0,5"/>
                                <NumericUpDown x:Name="RepeatPenaltyBox" Minimum="1" Maximum="2" Increment="0.05" FormatString="0.00"/>

                                <TextBlock Text="Макс. токенов (0 = без лимита):" Margin="0,10,0,5"/>
                                <NumericUpDown x:Name="MaxTokensBox" Minimum="0" Maximum="131072" Increment="256"/>

                                <TextBlock Text="Seed (-1 = случайно):" Margin="0,10,0,5"/>
                                <NumericUpDown x:Name="SeedBox" Minimum="-1" Maximum="2147483647" Increment="1"/>
                            </StackPanel>
                        </TabItem>
                                                <!-- Вкладка 3: Промпты -->
                        <TabItem Header="Промпты">
                            <StackPanel Margin="5">
                                <TextBlock Text="Файлы уходят в LLM только если выбраны. Пусто — запрос идёт как обычно."
                                           FontSize="11" Foreground="Gray" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <TextBlock Text="Первое сообщение (до инструкций):" Margin="0,0,0,5"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <TextBox Grid.Column="0" x:Name="PromptFirstBox" PlaceholderText="файл не выбран"/>
                                    <Button Grid.Column="1" Content="..." Width="34" Margin="5,0,0,0" Click="OnPickPromptFirst"/>
                                </Grid>

                                <TextBlock Text="Системный промпт:" Margin="0,0,0,5"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <TextBox Grid.Column="0" x:Name="PromptSystemBox" PlaceholderText="файл не выбран"/>
                                    <Button Grid.Column="1" Content="..." Width="34" Margin="5,0,0,0" Click="OnPickPromptSystem"/>
                                </Grid>

                                <TextBlock Text="Характер персонажа:" Margin="0,0,0,5"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <TextBox Grid.Column="0" x:Name="PromptCharacterBox" PlaceholderText="файл не выбран"/>
                                    <Button Grid.Column="1" Content="..." Width="34" Margin="5,0,0,0" Click="OnPickPromptCharacter"/>
                                </Grid>

                                <TextBlock Text="Описание персонажа:" Margin="0,0,0,5"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <TextBox Grid.Column="0" x:Name="PromptAppearanceBox" PlaceholderText="файл не выбран"/>
                                    <Button Grid.Column="1" Content="..." Width="34" Margin="5,0,0,0" Click="OnPickPromptAppearance"/>
                                </Grid>

                                <TextBlock Text="Как сохранять дневник:" Margin="0,0,0,5"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" x:Name="PromptDiarySaveBox" PlaceholderText="файл не выбран"/>
                                    <Button Grid.Column="1" Content="..." Width="34" Margin="5,0,0,0" Click="OnPickPromptDiarySave"/>
                                </Grid>
                            </StackPanel>
                        </TabItem>
                                                <!-- Вкладка 4: RAG -->
                        <TabItem Header="RAG">
                            <StackPanel Margin="5">
                                <TextBlock Text="Папка базы знаний:" Margin="0,0,0,5"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <TextBox Grid.Column="0" x:Name="RagPathBox" PlaceholderText="папка с .md / .txt"/>
                                    <Button Grid.Column="1" Content="..." Width="34" Margin="5,0,0,0" Click="OnPickRagPath"/>
                                </Grid>

                                <TextBlock Text="Embedding-модель:" Margin="0,0,0,5"/>
                                <TextBox x:Name="EmbedModelBox" PlaceholderText="qwen3-embedding:0.6b" Margin="0,0,0,10"/>

                                <TextBlock Text="Размер фрагмента (символов):" Margin="0,0,0,5"/>
                                <NumericUpDown x:Name="RagChunkSizeBox" Minimum="200" Maximum="8000" Increment="100" Margin="0,0,0,10"/>

                                <TextBlock Text="Топ-K фрагментов:" Margin="0,0,0,5"/>
                                <NumericUpDown x:Name="RagTopKBox" Minimum="1" Maximum="20" Increment="1" Margin="0,0,0,10"/>

                                <TextBlock Text="Порог релевантности (0–1):" Margin="0,0,0,5"/>
                                <NumericUpDown x:Name="RagThresholdBox" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" Margin="0,0,0,10"/>

                                <Button x:Name="BuildRagButton" Content="🔨 Построить индекс" Click="OnBuildRagIndex" Margin="0,0,0,10"/>
                                <TextBlock x:Name="RagStatusText" TextWrapping="Wrap" Foreground="Gray"/>
                            </StackPanel>
                        </TabItem>

                    </TabControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
